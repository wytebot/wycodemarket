# Flutterwave v4 — server-side only (only required if Market directly creates/verifies Flutterwave charges)
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_SECRET=

# If Wytelab is the central payment service, Market can accept only Wytelab-signed payment events.
WYCOD_MARKET_WEBHOOK_SECRET=
FLW_ENVIRONMENT=production

# Public HTTPS Market origin used for Flutterwave redirects
APP_URL=https://your-market-domain.vercel.app

# 32+ random characters; never expose in Vite/client code
DOWNLOAD_TOKEN_SECRET=

# Firebase Web Push
VITE_FIREBASE_VAPID_KEY=

# Firebase Admin / Google Drive server credentials
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Firebase Authentication: Google provider must be enabled.
# Flutterwave webhook should POST to: https://<market-domain>/api/webhook
# For direct Flutterwave mode, configure FLW_WEBHOOK_SECRET as the Flutterwave dashboard secret hash.
# For central Wytelab mode, configure WYCOD_MARKET_WEBHOOK_SECRET as the Wytelab→Market shared secret.

# WyCode automatically stores buyer reviews in the configured primary Drive folder and falls back to the secondary folder when storage quota is exceeded. Publishers do not enter review-folder IDs.
