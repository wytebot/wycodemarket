# Flutterwave v4 — server-side only
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_SECRET=
FLW_ENVIRONMENT=production

# Public HTTPS Market origin used for Flutterwave redirects
APP_URL=https://your-market-domain.vercel.app

# 32+ random characters; never expose in Vite/client code
DOWNLOAD_TOKEN_SECRET=

# Firebase Web Push
VITE_FIREBASE_VAPID_KEY=

# Firebase Admin / Google Drive server credentials
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_REVIEWS_FOLDER_ID=

# Firebase Authentication: Google provider must be enabled.
# Flutterwave webhook should POST to: https://<market-domain>/api/webhook
# Use the same FLW_WEBHOOK_SECRET configured for the Wytelab Flutterwave merchant/webhook.
