# =========================
# Flutterwave v4 (SERVER ONLY)
# =========================
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_SECRET=
FLW_ENVIRONMENT=production
# Must match the environment where your v4 Client ID/Secret/Encryption Key were created. Use sandbox for test credentials.
# TESTING ONLY: set true to grant Pro for free without charging Flutterwave. Disable for live.
PRO_FREE_TEST_MODE=false

# =========================
# WyCode Market
# =========================
APP_URL=https://your-market-domain.vercel.app
DOWNLOAD_TOKEN_SECRET=

# =========================
# Google Drive (SERVER ONLY)
# =========================
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# =========================
# Firebase Admin / Firestore (SERVER ONLY)
# Optional: if omitted, the Drive service-account JSON above is reused.
# The service account used must have Firestore access.
# =========================
FIREBASE_SERVICE_ACCOUNT_JSON=

# Pro purchase recovery (server-only)
RESEND_API_KEY=
RECOVERY_FROM_EMAIL=
# Optional manual Pro allowlist for testing; comma-separated emails.
PRO_RECOVERY_EMAILS=
